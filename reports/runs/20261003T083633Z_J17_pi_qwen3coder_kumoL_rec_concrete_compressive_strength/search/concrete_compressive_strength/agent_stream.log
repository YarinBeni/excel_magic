ain['Cement'] + 1e-8)\\n    X_test['aggregate_ratio'] = (X_test['CoarseAggregate'] + X_test['FineAggregate']) / (X_test['Cement'] + 1e-8)\\n    \\n    # Superplasticizer to cement ratio\\n    X_train['sp_to_cement'] = X_train['Superplasticizer'] / (X_train['Cement'] + 1e-8)\\n    X_test['sp_to_cement'] = X_test['Superplasticizer'] / (X_test['Cement'] + 1e-8)\\n    \\n    # Age effect\\n    X_train['age_squared'] = X_train['Age'] ** 2\\n    X_test['age_squared'] = X_test['Age'] ** 2\\n    \\n    # Interaction terms\\n    X_train['cement_age'] = X_train['Cement'] * X_train['Age']\\n    X_test['cement_age'] = X_test['Cement'] * X_test['Age']\\n    \\n    # Cement + Water interaction (inverse relationship)\\n    X_train['cement_water'] = X_train['Cement'] / (X_train['Water'] + 1e-8)\\n    X_test['cement_water'] = X_test['Cement'] / (X_test['Water'] + 1e-8)\\n    \\n    # Concrete mixture ratio (coarse + fine aggregate)\\n    X_train['total_aggregate'] = X_train['CoarseAggregate'] + X_train['FineAggregate']\\n    X_test['total_aggregate'] = X_test['CoarseAggregate'] + X_test['FineAggregate']\\n    \\n    # Normalize features but exclude the most important ones that already have good scales\\n    scaler = StandardScaler()\\n    feature_cols = ['Cement', 'BlastFurnaceSlag', 'FlyAsh', 'Water', 'Superplasticizer', \\n                   'CoarseAggregate', 'FineAggregate', 'Age', 'cementitious', 'wtr', \\n                   'aggregate_ratio', 'sp_to_cement', 'age_squared', 'cement_age',\\n                   'cement_water', 'total_aggregate']\\n    \\n    X_train[feature_cols] = scaler.fit_transform(X_train[feature_cols])\\n    X_test[feature_cols] = scaler.transform(X_test[feature_cols])\\n    \\n    return X_train, X_test\\n\\ndef sample(X_train, y_train, X_test, max_rows):\\n    return [np.arange(len(X_train))]  # one context view with all training rows\\n\\ndef postprocess(pred, y_train_orig, X_test):\\n    # Invert log transformation\\n    return np.exp(pred) - 1\\\"}]\"\n