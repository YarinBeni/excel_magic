   # Concrete mixture ratio (coarse + fine aggregate)\n    X_train['total_aggregate'] = X_train['CoarseAggregate'] + X_train['FineAggregate']\n    X_test['total_aggregate'] = X_test['CoarseAggregate'] + X_test['FineAggregate']\n    \n    return X_train, X_test\n\ndef sample(X_train, y_train, X_test, max_rows):\n    return [np.arange(len(X_train))]  # one context view with all training rows\n\ndef postprocess(pred, y_train_orig, X_test):\n    # Invert log transformation\n    return np.exp(pred) - 1"}],"isError":false,"timestamp":1791016912834}}
