g_url_relative_to_age'] = X_test_new['long_url_relative_to_age'].astype(int)\\n    \\n    # Create more complex interaction features\\n    if 'Request_URL' in X_train_new.columns and 'URL_of_Anchor' in X_train_new.columns:\\n        # Create a feature indicating mismatch between URL types\\n        X_train_new['url_anchor_mismatch'] = (X_train_new['Request_URL'] != X_train_new['URL_of_Anchor']).astype(int)\\n        X_test_new['url_anchor_mismatch'] = (X_test_new['Request_URL'] != X_test_new['URL_of_Anchor']).astype(int)\\n    \\n    # Count of suspicious indicators\\n    suspicious_indicators = ['popUpWidnow', 'Request_URL', 'URL_of_Anchor', 'having_IP_Address']\\n    suspicious_counts = []\\n    for col in suspicious_indicators:\\n        if col in X_train_new.columns:\\n            suspicious_counts.append(X_train_new[col].map({'Suspicious': 1, 'Phishy': 1, 'Legitimate': 0}).fillna(0))\\n    if suspicious_counts:\\n        X_train_new['suspicious_count'] = sum(suspicious_counts)\\n        \\n    suspicious_counts_test = []\\n    for col in suspicious_indicators:\\n        if col in X_test_new.columns:\\n            suspicious_counts_test.append(X_test_new[col].map({'Suspicious': 1, 'Phishy': 1, 'Legitimate': 0}).fillna(0))\\n    if suspicious_counts_test:\\n        X_test_new['suspicious_count'] = sum(suspicious_counts_test)\\n    \\n    # Create ratio features\\n    if 'URL_Length' in X_train_new.columns and 'age_of_domain' in X_train_new.columns:\\n        X_train_new['url_length_to_age_ratio'] = X_train_new['URL_Length'] / (X_train_new['age_of_domain'] + 1)\\n        X_test_new['url_length_to_age_ratio'] = X_test_new['URL_Length'] / (X_test_new['age_of_domain'] + 1)\\n    \\n    return X_train_new, X_test_new\\n\\n\\ndef sample(X_train, y_train, X_test, max_rows):\\n    return [np.arange(len(X_train))]  # one context view with all training rows\\n\\n\\ndef postprocess(pred, y_train_orig, X_test):\\n    return pred\""}}
