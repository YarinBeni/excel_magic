{"type":"tool_execution_start","toolCallId":"call_b8f6d5884e9543e1a46dbaa2","toolName":"write","args":{"path":"pipeline.py","content":"import numpy as np\nimport pandas as pd\nfrom sklearn.preprocessing import StandardScaler\n\nMODEL_KWARGS = {}  # constructor settings for the frozen model; {} keeps the defaults\n\n\ndef preprocess(X_train, y_train, X_test):\n    # Handle potential outliers in TotalBloodDonated\n    # Apply log transformation to skewed features\n    X_train = X_train.copy()\n    X_test = X_test.copy()\n    \n    # Log transform TotalBloodDonated to reduce skewness\n    X_train['TotalBloodDonated_log'] = np.log1p(X_train['TotalBloodDonated'])\n    X_test['TotalBloodDonated_log'] = np.log1p(X_test['TotalBloodDonated'])\n    \n    # Remove original TotalBloodDonated column\n    X_train = X_train.drop('TotalBloodDonated', axis=1)\n    X_test = X_test.drop('TotalBloodDonated', axis=1)\n    \n    return X_train, y_train, X_test\n\n\ndef engineer(X_train, y_train, X_test):\n    # Create additional meaningful features\n    X_train = X_train.copy()\n    X_test = X_test.copy()\n    \n    # Ratio features\n    X_train['donation_rate'] = X_train['NumberOfDonations'] / (X_train['MonthsSinceFirstDonation'] + 1)\n    X_test['donation_rate'] = X_test['NumberOfDonations'] / (X_test['MonthsSinceFirstDonation'] + 1)\n    \n    # Age-like feature (how long since last donation relative to total history)\n    X_train['recent_donation_ratio'] = X_train['MonthsSinceLastDonation'] / (X_train['MonthsSinceFirstDonation'] + 1)\n    X_test['recent_donation_ratio'] = X_test['MonthsSinceLastDonation'] / (X_test['MonthsSinceFirstDonation'] + 1)\n    \n    # Interaction features\n    X_train['donation_interaction'] = X_train['NumberOfDonations'] * X_train['MonthsSinceLastDonation']\n    X_test['donation_interaction'] = X_test['NumberOfDonations'] * X_test['MonthsSinceLastDonation']\n    \n    # Binned features\n    X_train['donation_bins'] = pd.cut(X_train['NumberOfDonations'], bins=4, labels=False)\n    X_test['donation_bins'] = pd.cut(X_test['NumberOfDonations'], bins=4, labels=False)\n    \n    return X_train, X_test\n\n\ndef sample(X_train, y_train, X_test, max_rows):\n    # Create multiple context views to capture different patterns\n    # Since we have some duplicates, we want to avoid biasing the model toward them\n    \n    # Create stratified samples to ensure both classes are represented\n    indices = np.arange(len(X_train))\n    np.random.shuffle(indices)\n    \n    # Split into 3 views for 3-fold CV\n    view1 = indices[:len(indices)//3]\n    view2 = indices[len(indices)//3:2*len(indices)//3] \n    view3 = indices[2*len(indices)//3:]\n    \n    return [view1, view2, view3]\n\n\ndef postprocess(pred, y_train_orig, X_test):\n    return pred"}}
