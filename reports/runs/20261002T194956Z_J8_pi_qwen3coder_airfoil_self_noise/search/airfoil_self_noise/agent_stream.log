Product features\\n    X_train_new['frequency_velocity_product'] = X_train_new['frequency'] * X_train_new['free-stream-velocity']\\n    X_test_new['frequency_velocity_product'] = X_test_new['frequency'] * X_test_new['free-stream-velocity']\\n    \\n    # Log features for skewness reduction\\n    X_train_new['log_frequency'] = np.log(X_train_new['frequency'] + 1e-8)\\n    X_test_new['log_frequency'] = np.log(X_test_new['frequency'] + 1e-8)\\n    \\n    X_train_new['log_chord_length'] = np.log(X_train_new['chord-length'] + 1e-8)\\n    X_test_new['log_chord_length'] = np.log(X_test_new['chord-length'] + 1e-8)\\n    \\n    # Scaled features\\n    scaler = StandardScaler()\\n    feature_cols = ['frequency', 'attack-angle', 'chord-length', 'free-stream-velocity', 'suction-side-displacement-thickness']\\n    X_train_new[feature_cols] = scaler.fit_transform(X_train_new[feature_cols])\\n    X_test_new[feature_cols] = scaler.transform(X_test_new[feature_cols])\\n    \\n    return X_train_new, X_test_new\\n\\n\\ndef sample(X_train, y_train, X_test, max_rows):\\n    return [np.arange(len(X_train))]  # one context view with all training rows\\n\\n\\ndef postprocess(pred, y_train_orig, X_test):\\n    # Invert the log transformation\\n    return np.exp(pred) - 1e-8\\\"}\\n]\""}}
