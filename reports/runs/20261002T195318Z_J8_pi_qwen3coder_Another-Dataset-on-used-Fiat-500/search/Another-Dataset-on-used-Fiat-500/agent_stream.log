rain, y_train, X_test, max_rows):\n    return [np.arange(len(X_train))]  # one context view with all training rows\n\n\ndef postprocess(pred, y_train_orig, X_test):\n    # Invert log transformation - ensure we're dealing with a Series\n    if isinstance(pred, pd.DataFrame):\n        pred = pred.iloc[:, 0]  # Take first column if it's a DataFrame\n    return np.exp(pred) - 1"}}
