odDonated'] = np.log1p(X_test['TotalBloodDonated'])\n    \n    # Ratio features\n    X_train['DonationRatio'] = X_train['NumberOfDonations'] / (X_train['MonthsSinceFirstDonation'] + 1)\n    X_test['DonationRatio'] = X_test['NumberOfDonations'] / (X_test['MonthsSinceFirstDonation'] + 1)\n    \n    # Interaction features\n    X_train['DonationInteraction'] = X_train['NumberOfDonations'] * X_train['MonthsSinceLastDonation']\n    X_test['DonationInteraction'] = X_test['NumberOfDonations'] * X_test['MonthsSinceLastDonation']\n    \n    return X_train, X_test\n\n\ndef sample(X_train, y_train, X_test, max_rows):\n    return [np.arange(len(X_train))]  # one context view with all training rows\n\n\ndef postprocess(pred, y_train_orig, X_test):\n    return pred"}}}}
