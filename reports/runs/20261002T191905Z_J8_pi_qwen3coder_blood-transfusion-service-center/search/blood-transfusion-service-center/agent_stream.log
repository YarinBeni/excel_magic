n the updated `pipeline.py` file and documented in `NOTES.md`."}],"api":"openai-completions","provider":"vllm","model":"Qwen/Qwen3-Coder-30B-A3B-Instruct","usage":{"input":12523,"output":259,"cacheRead":0,"cacheWrite":0,"reasoning":0,"totalTokens":12782,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"stop","timestamp":1790968857521,"responseId":"chatcmpl-adafef527945afa7","rawStopReason":"stop","thinkingLevel":"off"}],"willRetry":false}
