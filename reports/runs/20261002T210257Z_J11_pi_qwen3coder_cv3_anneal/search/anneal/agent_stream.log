ndas as pd\nfrom sklearn.preprocessing import LabelEncoder\nfrom sklearn.feature_extraction import DictVectorizer\nfrom sklearn.preprocessing import StandardScaler\n\nMODEL_KWARGS = {}  # constructor settings for the frozen model; {} keeps the defaults\n\n\ndef preprocess(X_train, y_train, X_test):\n    # Handle categorical variables by encoding them\n    # First, identify categorical columns\n    categorical_columns = X_train.select_dtypes(include=['category', 'object']).columns.tolist()\n    \n    # Fit label encoders on training data and transform both train and test\n    le_dict = {}\n    for col in categorical_columns:\n        if col in X_train.columns:\n            le = LabelEncoder()\n            # Fit on train + test to handle unseen categories\n            combined_data = pd.concat([X_train[col], X_test[col]], ignore_index=True)\n            le.fit(combined_data)\n            le_dict[col] = le\n            \n            # Transform train and test\n            X_train[col] = le.transform(X_train[col])\n            X_test[col] = le.transform(X_test[col])\n    \n    return X_train, y_train, X_test\n\n\ndef engineer(X_train, y_train, X_test):\n    # Create some engineered features that might help\n    # Ratio features based on domain knowledge\n    if 'strength' in X_train.columns and 'carbon' in X_train.columns:\n        X_train['strength_to_carbon'] = X_train['strength'] / (X_train['carbon'] + 1e-8)\n        X_test['strength_to_carbon'] = X_test['strength'] / (X_test['carbon'] + 1e-8)\n    \n    if 'hardness' in X_train.columns and 'carbon' in X_train.columns:\n        X_train['hardness_to_carbon'] = X_train['hardness'] / (X_train['carbon'] + 1e-8)\n        X_test['hardness_to_carbon'] = X_test['hardness'] / (X_test['carbon'] + 1e-8)\n    \n    # Polynomial features for important numerical columns\n    numerical_cols = ['carbon', 'hardness', 'strength', 'thick', 'width', 'len']\n    for i, col1 in enumerate(numerical_cols):\n        for col2 in numerical_col