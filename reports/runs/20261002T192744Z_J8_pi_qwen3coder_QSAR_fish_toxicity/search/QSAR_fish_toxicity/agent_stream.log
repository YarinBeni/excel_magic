test_new['CIC0'] + X_test_new['GATS1i']\n    \n    # Interaction terms\n    X_train_new['NdsCH_NdssC_interaction'] = X_train_new['NdsCH'] * X_train_new['NdssC']\n    X_test_new['NdsCH_NdssC_interaction'] = X_test_new['NdsCH'] * X_test_new['NdssC']\n    \n    return X_train_new, X_test_new\n\n\ndef sample(X_train, y_train, X_test, max_rows):\n    return [np.arange(len(X_train))]  # one context view with all training rows\n\n\ndef postprocess(pred, y_train_orig, X_test):\n    # Invert the log transformation\n    return 10 ** pred - 1e-8\"}\n]"}}
