n                               combined['FlyAsh'])\\\\n    \\\\n    # Water-to-cementitious ratio\\\\n    combined['water_cementitious_ratio'] = combined['Water'] / (combined['cementitious'] + 1e-8)\\\\n    \\\\n    # Strength-related ratios\\\\n    combined['cement_superplasticizer_ratio'] = combined['Cement'] / (combined['Superplasticizer'] + 1e-8)\\\\n    \\\\n    # Age effects\\\\n    combined['age_squared'] = combined['Age'] ** 2\\\\n    \\\\n    # Interaction terms\\\\n    combined['cement_age'] = combined['Cement'] * combined['Age']\\\\n    combined['water_age'] = combined['Water'] * combined['Age']\\\\n    \\\\n    # Normalize some features\\\\n    scaler = StandardScaler()\\\\n    feature_cols = ['Cement', 'BlastFurnaceSlag', 'FlyAsh', 'Water', 'Superplasticizer', \\\\n                   'CoarseAggregate', 'FineAggregate', 'Age', 'water_cement_ratio', \\\\n                   'coarse_fine_ratio', 'cementitious', 'water_cementitious_ratio', \\\\n                   'cement_superplasticizer_ratio', 'age_squared', 'cement_age', 'water_age']\\\\n    \\\\n    # Only fit scaler on training data\\\\n    combined_scaled = combined.copy()\\\\n    combined_scaled[feature_cols] = scaler.fit_transform(combined[feature_cols])\\\\n    \\\\n    # Split back into train and test\\\\n    X_train_new = combined_scaled.iloc[:n_train]\\\\n    X_test_new = combined_scaled.iloc[n_train:]\\\\n    \\\\n    return X_train_new, X_test_new\\\\n\\\\ndef sample(X_train, y_train, X_test, max_rows):\\\\n    return [np.arange(len(X_train))]  # one context view with all training rows\\\\n\\\\ndef postprocess(pred, y_train_orig, X_test):\\\\n    return pred\\\"}]\""}}
