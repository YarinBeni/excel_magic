] * X_test_new['GATS1i']\n    \n    # Add polynomial features (squared terms)\n    for col in ['CIC0', 'SM1_Dz(Z)', 'GATS1i', 'MLOGP']:\n        if col in X_train.columns:\n            X_train_new[f'{col}_squared'] = X_train_new[col] ** 2\n            X_test_new[f'{col}_squared'] = X_test_new[col] ** 2\n    \n    return X_train_new, X_test_new\n\n\ndef sample(X_train, y_train, X_test, max_rows):\n    return [np.arange(len(X_train))]  # one context view with all training rows\n\n\ndef postprocess(pred, y_train_orig, X_test):\n    # Invert the log transformation\n    return np.exp(pred) - 1e-8\"}]"}}}}
