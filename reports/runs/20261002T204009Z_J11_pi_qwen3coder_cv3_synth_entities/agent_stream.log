nt feature engineering\n    df_combined = pd.concat([df_train, df_test], ignore_index=True)\n    \n    # Feature engineering based on domain knowledge\n    # 1. Frequency of (role, resource) pairs\n    role_resource_freq = df_combined.groupby(['role_id', 'resource_id']).size().reset_index(name='role_resource_count')\n    df_combined = df_combined.merge(role_resource_freq, on=['role_id', 'resource_id'], how='left')\n    \n    # 2. Manager request volume\n    manager_request_count = df_combined.groupby('manager_id').size().reset_index(name='manager_request_count')\n    df_combined = df_combined.merge(manager_request_count, on='manager_id', how='left')\n    \n    # 3. Role frequency\n    role_freq = df_combined.groupby('role_id').size().reset_index(name='role_count')\n    df_combined = df_combined.merge(role_freq, on='role_id', how='left')\n    \n    # 4. Resource frequency\n    resource_freq = df_combined.groupby('resource_id').size().reset_index(name='resource_count')\n    df_combined = df_combined.merge(resource_freq, on='resource_id', how='left')\n    \n    # 5. Create interaction features\n    df_combined['role_resource_interaction'] = df_combined['role_id'] * 1000 + df_combined['resource_id']\n    \n    # 6. Normalize some counts\n    df_combined['role_resource_count_norm'] = df_combined['role_resource_count'] / df_combined['role_resource_count'].max()\n    df_combined['manager_request_count_norm'] = df_combined['manager_request_count'] / df_combined['manager_request_count'].max()\n    \n    # Split back into train and test maintaining original column structure\n    X_train_new = df_combined.iloc[:len(X_train)].drop(columns=['approved'])\n    X_test_new = df_combined.iloc[len(X_train):].copy()\n    \n    # Ensure same columns in both datasets (reindex to match original columns)\n    X_train_new = X_train_new.reindex(columns=X_train.columns, fill_value=0)\n    X_test_new = X_test_new.reindex(columns=X_train.columns, fill_value=0)\n    \n    return X_train_new, X_test_new\n\n\ndef sample(X_train, y_train, X_test, max_rows):\n    return [np.arange(len(X_train))]  # one context view with all training rows\n\n\ndef postprocess(pred, y_train_orig, X_test):\n    return pred"}}}}
